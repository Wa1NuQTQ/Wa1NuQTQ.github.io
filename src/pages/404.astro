---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";
---

<MainGridLayout title="页面走丢了" description="这个页面不存在，或已经被移动。">
    <meta slot="head" name="robots" content="noindex" />
    <div class="card-base px-9 py-12 text-center">
        <p class="text-6xl font-bold text-[var(--primary)]">404</p>
        <h1 class="mt-4 text-3xl font-bold text-90">页面走丢了</h1>
        <p class="mt-4 text-50">这个页面不存在，或已经被移动。可以返回首页，或去归档看看。</p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a class="btn-regular rounded-lg px-5 py-3" href={url("/")}>返回首页</a>
            <a class="btn-regular rounded-lg px-5 py-3" href={url("/archive/")}>浏览归档</a>
        </div>
    </div>
</MainGridLayout>
